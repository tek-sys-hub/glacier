/* ==========================================================================
   GLACIER : NATURAL MINERAL WATER
   Authentic Luxury Editorial Typography & Layout (Anti-AI Aesthetics)
   ========================================================================== */

:root {
  --text-dark: #090e17;
  --text-body: #233144;
  --text-muted: #64748b;
  --accent-cyan: #0284c7;
  --accent-pure: #059669;
  --accent-gold: #d97706;
  --hairline-dark: rgba(9, 14, 23, 0.85);
  --hairline-mid: rgba(9, 14, 23, 0.15);
  --hairline-faint: rgba(9, 14, 23, 0.08);
  --font-display: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reset & Lock Viewport (ZERO PHYSICAL PAGE SCROLL) */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  width: 100vw;
  height: 100vh;
  overflow: hidden !important; /* Page does not physically scroll */
  position: fixed;
  background-color: #0b1523;
  color: var(--text-dark);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-dark);
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  outline: none;
  background: none;
}

/* ==========================================================================
   FIXED VIEWPORT STAGE (CANVAS & PURE CIRCULAR FOGGY ZONE)
   ========================================================================== */
.fixed-stage-wrap {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  background: #0b1523;
}

/* Canvas 1: Rock-Still Bottle (Anchored Right) */
#global-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  z-index: 1;
}

/* 
   REFINED CIRCULAR FOG DOME:
   - Graceful, balanced circular curvature centered at (2vw, 50vh)
   - Deep solid pure white covering all content from 0vw to ~32vw
   - Smooth circular fog feathering transparently between 32vw and ~58vw
   - Leaving the right 42vw+ completely clear and dark for the bottle showcase
*/
.circular-cloud-wash {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 2;
  background:
    radial-gradient(
      circle at 2vw 50vh,
      #ffffff 0%,
      #ffffff 29vw,
      rgba(255, 255, 255, 0.98) 36vw,
      rgba(255, 255, 255, 0.82) 43vw,
      rgba(240, 249, 255, 0.45) 49vw,
      rgba(224, 242, 254, 0.15) 54vw,
      transparent 58vw
    ),
    radial-gradient(
      circle at 2vw 50vh,
      transparent 0%,
      transparent 38vw,
      rgba(2, 132, 199, 0.08) 47vw,
      rgba(2, 132, 199, 0.02) 54vw,
      transparent 58vw
    );
  filter: drop-shadow(15px 0 45px rgba(2, 132, 199, 0.08));
}

/* ==========================================================================
   MINIMALIST EDITORIAL NAVIGATION
   ========================================================================== */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  padding: 2.0rem 3.8rem;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.nav-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-brand {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.brand-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: 0.22em;
  color: var(--text-dark);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2.5rem;
  margin-left: 2rem;
}

.nav-link {
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  transition: var(--transition);
  padding: 0.3rem 0;
  position: relative;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 1px;
  background: var(--text-dark);
  transition: width 0.25s ease;
}

.nav-link:hover, .nav-link.active {
  color: var(--text-dark);
}

.nav-link.active::after {
  width: 100%;
}

.nav-actions {
  display: flex;
  align-items: center;
}

/* Minimalist Editorial Bag Link (Visible on dark right area) */
.cart-link {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #ffffff;
  padding: 0.4rem 0.95rem;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 2px;
  background: rgba(11, 21, 35, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: var(--transition);
}

.cart-link:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: #ffffff;
}

.cart-counter {
  font-family: var(--font-display);
  font-weight: 700;
}

/* ==========================================================================
   DISCRETE SLIDE DOCKED CONTENT ENGINE (EXPANSIVE LUXURY EDITORIAL MATRIX)
   ========================================================================== */
.in-place-content-stage {
  position: fixed;
  top: 0;
  left: 0;
  width: 48vw;
  max-width: 760px;
  height: 100vh;
  z-index: 10;
  pointer-events: none;
  overflow: hidden;
}

.scroll-track {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  will-change: transform;
}

.content-slide {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 4.5rem;
  padding-right: 1.8rem;
  will-change: transform, opacity;
  pointer-events: none;
}

.slide-inner {
  width: 100%;
}

/* Meta Labels: Clean Micro Typography (NO Pill Bubble Backgrounds) */
.slide-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 0.8rem;
  border-bottom: 1px solid var(--hairline-faint);
  padding-bottom: 0.5rem;
}

.slide-tag {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-dark);
}

.editorial-meta {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* Hero Typography */
.slide-eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--accent-cyan);
  display: block;
  margin-bottom: 0.85rem;
}

.slide-hero-title {
  font-family: var(--font-display);
  font-size: clamp(4.0rem, 6.8vw, 6.0rem);
  font-weight: 900;
  letter-spacing: -0.04em;
  line-height: 0.95;
  color: var(--text-dark);
  margin-bottom: 1.15rem;
}

.slide-caption {
  font-size: 1.05rem;
  color: var(--text-body);
  line-height: 1.65;
  margin-bottom: 2.2rem;
  max-width: 580px;
}

/* Chapter Slide Typography */
.slide-title {
  font-family: var(--font-display);
  font-size: clamp(2.1rem, 3.0vw, 2.6rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: var(--text-dark);
  margin-bottom: 0.75rem;
}

.slide-text {
  font-size: 0.98rem;
  color: var(--text-body);
  line-height: 1.65;
  margin-bottom: 2rem;
  max-width: 620px;
}

/* ==========================================================================
   EDITORIAL QUICK SPEC STRIP (ZERO BOXING, ZERO SHADOWS)
   ========================================================================== */
.hero-quick-tabulate {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
  border-top: 1px solid var(--hairline-mid);
  border-bottom: 1px solid var(--hairline-mid);
  padding: 1.4rem 0;
  margin-bottom: 2.5rem;
  background: transparent !important;
  box-shadow: none !important;
  border-radius: 0 !important;
}

.hero-quick-tabulate .tab-col {
  display: flex;
  flex-direction: column;
}

.hero-quick-tabulate .tab-label {
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-bottom: 0.35rem;
}

.hero-quick-tabulate .tab-val {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-dark);
  font-variant-numeric: tabular-nums;
}

.hero-quick-tabulate .tab-sub {
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 0.2rem;
}

/* Refined Minimalist Scroll Prompt (NO cartoon mouse icons) */
.editorial-scroll-prompt {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.scroll-hairline {
  width: 32px;
  height: 1px;
  background: var(--text-dark);
}

.scroll-txt {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* ==========================================================================
   AUTHENTIC LUXURY TABULATION (OPEN EDITORIAL MATRIX : NO CARD BOXES)
   ========================================================================== */
.tabulate-wrap {
  width: 100%;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  border-radius: 0 !important;
  overflow: visible;
}

.tabulate-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.tabulate-table th {
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--text-muted);
  padding: 0.65rem 0;
  background: transparent !important;
  border-bottom: 1px solid var(--hairline-dark);
}

.tabulate-table td {
  padding: 0.75rem 0;
  border-bottom: 1px solid var(--hairline-faint);
  font-size: 0.92rem;
  color: var(--text-body);
  vertical-align: top;
}

.tabulate-table tr:last-child td {
  border-bottom: 1px solid var(--hairline-mid);
}

.cell-primary {
  font-weight: 600;
  color: var(--text-dark);
  font-size: 0.94rem;
  line-height: 1.35;
}

.cell-sub {
  font-size: 0.76rem;
  color: var(--text-muted);
  margin-top: 0.2rem;
}

/* Clean Typographic Data Values (NO generic AI pill bubbles) */
.data-val {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-dark);
  font-variant-numeric: tabular-nums;
  display: inline-block;
  white-space: nowrap;
}

.data-val.cyan {
  color: var(--accent-cyan);
}

.data-val.pure {
  color: var(--accent-pure);
}

.data-val.gold {
  color: var(--accent-gold);
}

.highlight-val {
  color: var(--accent-cyan) !important;
}

.spec-note {
  font-size: 0.86rem;
  color: var(--text-body);
}

/* ==========================================================================
   CELLAR ORDER MATRIX & ARCHITECTURAL BUTTONS
   ========================================================================== */
.order-table th, .order-table td {
  padding: 1.15rem 0;
}

.price-strong {
  font-family: var(--font-display);
  font-size: 1.18rem;
  font-weight: 700;
  color: var(--text-dark);
  font-variant-numeric: tabular-nums;
}

/* Architectural Luxury Button (Crisp edges, zero bubble pills) */
.reserve-btn {
  padding: 0.55rem 1.35rem;
  background: transparent;
  border: 1px solid var(--text-dark);
  color: var(--text-dark);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  border-radius: 2px;
  transition: var(--transition);
  cursor: pointer;
  white-space: nowrap;
}

.reserve-btn:hover {
  background: var(--text-dark);
  color: #ffffff;
}



/* ==========================================================================
   CART SLIDE-OUT DRAWER
   ========================================================================== */
.cart-drawer {
  position: fixed;
  inset: 0;
  z-index: 200;
  visibility: hidden;
  transition: visibility 0.3s ease;
}

.cart-drawer.open {
  visibility: visible;
}

.cart-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(9, 14, 23, 0.45);
  backdrop-filter: blur(8px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.cart-drawer.open .cart-backdrop {
  opacity: 1;
}

.cart-panel {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  max-width: 420px;
  height: 100%;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: -15px 0 40px rgba(0, 0, 0, 0.08);
}

.cart-drawer.open .cart-panel {
  transform: translateX(0);
}

.cart-header {
  padding: 2.2rem 2rem 1.4rem;
  border-bottom: 1px solid var(--hairline-faint);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-heading {
  font-size: 1.15rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-dark);
}

.close-btn {
  font-size: 1.8rem;
  line-height: 1;
  color: var(--text-muted);
}

.close-btn:hover {
  color: var(--text-dark);
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 1.8rem;
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
}

.empty-text {
  text-align: center;
  color: var(--text-muted);
  margin-top: 3.5rem;
  font-size: 0.95rem;
}

.cart-card {
  display: flex;
  gap: 1.1rem;
  border-bottom: 1px solid var(--hairline-faint);
  padding-bottom: 1.2rem;
  align-items: center;
}

.cart-card-img {
  width: 52px;
  height: 52px;
  border-radius: 2px;
  object-fit: cover;
  border: 1px solid var(--hairline-faint);
}

.cart-card-info {
  flex: 1;
}

.cart-card-name {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--text-dark);
}

.cart-card-price {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin-top: 0.15rem;
}

.cart-qty-ctrl {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.qty-btn {
  width: 26px;
  height: 26px;
  border-radius: 2px;
  border: 1px solid var(--hairline-mid);
  background: transparent;
  color: var(--text-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
}

.qty-btn:hover {
  background: var(--text-dark);
  color: #ffffff;
}

.cart-footer {
  padding: 2rem;
  border-top: 1px solid var(--hairline-faint);
  background: #ffffff;
}

.cart-total-row {
  display: flex;
  justify-content: space-between;
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 0.4rem;
}

.shipping-note {
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-bottom: 1.4rem;
}

.checkout-btn {
  width: 100%;
  padding: 1rem;
  border-radius: 2px;
  background: var(--text-dark);
  color: #ffffff;
  font-weight: 700;
  font-size: 0.82rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  transition: var(--transition);
  border: 1px solid var(--text-dark);
}

.checkout-btn:hover {
  background: transparent;
  color: var(--text-dark);
}

/* ==========================================================================
   RESPONSIVE DESIGN (TABLETS & MOBILE)
   ========================================================================== */
@media (max-width: 1024px) {
  .navbar {
    padding: 1.5rem 2rem;
  }
  .nav-links {
    display: none;
  }
  .in-place-content-stage {
    width: 72vw;
    padding-left: 2.5rem;
  }
  .hero-quick-tabulate {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .navbar {
    padding: 1.2rem 1.5rem;
  }
  .in-place-content-stage {
    width: 92vw;
    padding-left: 1.2rem;
  }
  .hero-quick-tabulate {
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }
  .tabulate-table th, .tabulate-table td {
    padding: 0.75rem 0;
    font-size: 0.82rem;
  }
}
